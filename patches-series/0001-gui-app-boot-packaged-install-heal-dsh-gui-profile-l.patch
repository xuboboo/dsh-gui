+/**
+ * dsh-gui: deploy EVERY @dsh-gui browser plugin (dsh.client.platform ===
+ * "web") from the installation's @dsh-gui scope into one profile so its UI
+ * appears on every machine (fresh install and upgrade alike) without manual
+ * steps. The plugins are dual-anchored: the host half resolves from the
+ * installation tree (app.asar node_modules), while the client scanner
+ * discovers the browser half through createRequire(profile baseUrl) — i.e.
+ * only from the profile layer. For each such package this maintains: an
+ * entity copy under <profile>/<name>, and a junction at
+ * <profile>/node_modules/@dsh-gui/<name> -> entity. (Host-half mounting is
+ * NOT done here — bundles that need a default mount carry their own insert
+ * row, e.g. mcp-catalog below and plugin-market via the web-app patch.)
+ * Fully defensive: any failure logs and leaves the profile untouched — a
+ * deployment hiccup must never brick boot. Idempotent: an already-current
+ * entity/junction is left exactly as-is.
+ * @param installAnchor - the installation manifest path (app package.json).
+ * @param profileDir - the profile directory to deploy into.
+ */
+function ensureGuiBrowserPluginsProfileLayer(installAnchor: string, profileDir: string): void {
+  const asarNm = dirname(dirname(dirname(installAnchor)))
+  const scopeDir = join(asarNm, '@dsh-gui')
+  if (!existsSync(scopeDir)) return
+  for (const name of readdirSync(scopeDir)) {
+    const srcPkg = join(scopeDir, name)
+    if (!existsSync(join(srcPkg, 'package.json'))) continue
+    let platform: unknown
+    try {
+      const pkg = JSON.parse(readFileSync(join(srcPkg, 'package.json'), 'utf8'))
+      platform = pkg?.dsh?.client?.platform
+    } catch { continue }
+    if (platform !== 'web') continue
+    try { deployGuiBrowserHalf(srcPkg, profileDir, name) } catch (error) {
+      console.warn(`dsh-app-boot: @dsh-gui/${name} profile deploy failed: ${error instanceof Error ? error.message : String(error)}`)
+    }
+  }
