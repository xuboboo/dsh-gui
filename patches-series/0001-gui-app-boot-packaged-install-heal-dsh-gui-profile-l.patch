+function guiDesktopDirs(installAnchor: string): { unpackedNm: string; seedNm: string; seedPresent: boolean } {
+  const exeDir = dirname(dirname(dirname(dirname(dirname(installAnchor)))))
+  const unpackedNm = join(exeDir, 'app.asar.unpacked', 'node_modules')
+  const seedNm = join(exeDir, 'dsh-profile-seed', 'node_modules')
+  const seedPresent = existsSync(join(exeDir, 'dsh-profile-seed', '.seed.json'))
+  return { unpackedNm, seedNm, seedPresent }
+}
+
+/** Whether an optional package name targets a platform this process never loads. */
+function isForeignPlatformPackage(name: string): boolean {
+  const platform = process.platform
+  if (platform === 'win32' && /-win32[-.]/.test(name)) return false
+  if (platform === 'linux' && /-linux[-.]/.test(name)) return false
+  if (platform === 'darwin' && /-darwin[-.]/.test(name)) return false
+  return /(^|[-.])(linux|darwin|win32|musl|freebsd|android)([-.]|$)/.test(name)
+}
