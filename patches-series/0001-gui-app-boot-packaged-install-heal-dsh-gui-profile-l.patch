+// ---------------------------------------------------------------------------
+// dsh-gui: packaged-install heal (seed junctions, byte freshness, native and
+// client-plugin coverage). The generic symlink fallback above resolves links
+// straight into the running application archive; a packaged desktop build
+// ships the runtime inside an Electron app.asar, whose interior paths Node's
+// ESM loader cannot resolve through a junction (the child runtime runs under
+// ELECTRON_RUN_AS_NODE). The helpers below let the fallback point at the
+// shipped real-file seed (resources/dsh-profile-seed) whenever its bytes match
+// the running closure, and materialize real copies otherwise — plus the MCP
+// catalog browser half every profile needs on its node_modules layer.
+// ---------------------------------------------------------------------------
+
+/** Read the fallback completion stamp, or `undefined` when absent or corrupt. */
+function readHealStamp(modulesDir: string): Set<string> | undefined {
+  try {
+    const stamp = JSON.parse(readFileSync(join(modulesDir, HEAL_STAMP_FILENAME), 'utf8'))
+    if (stamp === null || typeof stamp !== 'object' || !Array.isArray(stamp.packages)) return undefined
+    return new Set(stamp.packages)
+  } catch {
+    return undefined
+  }
+}
+
+/** Whether two package.json files describe the same package (name + version). */
+function manifestsMatch(left: string, right: string): boolean {
+  try {
+    const a = JSON.parse(readFileSync(left, 'utf8'))
+    const b = JSON.parse(readFileSync(right, 'utf8'))
+    return a?.name === b?.name && a?.version === b?.version
+  } catch {
+    return false
+  }
+}
+
+/** Resolve a package's `exports["./client"]` to a relative path (string or one-level `{ default }` form). */
+function clientBundleRelOf(pkg: unknown): string | undefined {
+  const exportsField = pkg !== undefined && pkg !== null && typeof pkg === 'object' ? (pkg as Record<string, unknown>).exports : undefined
+  if (exportsField === undefined || exportsField === null || typeof exportsField !== 'object') return undefined
+  const client = (exportsField as Record<string, unknown>)['./client']
+  if (client === undefined) return undefined
+  if (typeof client === 'string') return client
+  if (typeof client === 'object' && client !== null) {
+    const fallback = (client as Record<string, unknown>).default
+    if (typeof fallback === 'string') return fallback
+  }
+  return undefined
+}
+
+/** Resolve a package's runtime entry (exports["."] default, else `main`) to a relative path. */
+function entryRelOf(pkgDir: string): string | undefined {
+  try {
+    const pkg = JSON.parse(readFileSync(join(pkgDir, 'package.json'), 'utf8'))
+    const exportsField = pkg !== undefined && pkg !== null && typeof pkg === 'object' ? pkg.exports : undefined
+    const dot = exportsField !== undefined && exportsField !== null && typeof exportsField === 'object' ? exportsField['.'] : undefined
+    let rel: string | undefined
+    if (typeof dot === 'string') rel = dot
+    else if (dot !== undefined && dot !== null && typeof dot === 'object' && typeof dot.default === 'string') rel = dot.default
+    if ((rel === undefined || rel === '') && typeof pkg?.main === 'string') rel = pkg.main
+    if (typeof rel !== 'string' || rel === '') return undefined
+    return rel.replace(/^\.\//, '')
+  } catch {
+    return undefined
+  }
+}
+
+/**
+ * Whether two package copies are interchangeable: manifest (name+version)
+ * AND the bytes that actually run — the served client bundle for web client
+ * plugins, and the runtime entry for every package. A stale seed can carry
+ * the same manifest version with an outdated bundle, which a version-only
+ * check would wrongly treat as fresh (the upgrade-machine
+ * "client-modules: missed the module table" class). Fully defensive: any
+ * unexpected error reports "not fresh" (the materialize direction), so a
+ * heal bug can never brick the boot.
+ */
+function closureFresh(
+  linkDir: string, targetDir: string, packageName: string,
+  clientPluginBundles: ReadonlyMap<string, string>,
+): boolean {
+  try {
+    if (!manifestsMatch(join(linkDir, 'package.json'), join(targetDir, 'package.json'))) return false
+    const rel = clientPluginBundles.get(packageName)
+    if (rel !== undefined && !readFileSync(join(linkDir, rel)).equals(readFileSync(join(targetDir, rel)))) return false
+    const entry = entryRelOf(targetDir) ?? entryRelOf(linkDir)
+    if (entry === undefined) return true
+    return readFileSync(join(linkDir, entry)).equals(readFileSync(join(targetDir, entry)))
+  } catch {
+    return false
+  }
+}
+
+/** Recursively copy one package directory (asar-aware source reads). */
+function copyPackageDir(source: string, target: string): void {
+  mkdirSync(target, { recursive: true })
+  for (const entry of readdirSync(source)) {
+    const s = join(source, entry)
+    const t = join(target, entry)
+    if (lstatSync(s).isDirectory()) copyPackageDir(s, t)
+    else {
+      mkdirSync(dirname(t), { recursive: true })
+      writeFileSync(t, readFileSync(s))
+    }
+  }
+}
+
+/** Copy files from `source` into an existing `target`, never overwriting. */
+function fillMissingFiles(source: string, target: string): void {
+  if (!existsSync(target)) return
+  for (const entry of readdirSync(source)) {
+    const s = join(source, entry)
+    const t = join(target, entry)
+    if (lstatSync(s).isDirectory()) fillMissingFiles(s, t)
+    else if (!existsSync(t)) {
+      mkdirSync(dirname(t), { recursive: true })
+      writeFileSync(t, readFileSync(s))
+    }
+  }
+}
+
+/**
+ * Desktop layout roots derived from the install anchor:
+ * `<exe>/app.asar.unpacked/node_modules` (native binaries) and
+ * `<exe>/dsh-profile-seed` (the shipped real-file closure copy).
