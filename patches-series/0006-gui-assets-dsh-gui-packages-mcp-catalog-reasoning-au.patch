+	".dshgui-mcp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 10px; }",
+	".dshgui-mcp-card { border: 1px solid color-mix(in srgb, currentColor 18%, transparent); border-radius: 10px; padding: 10px 12px; display: flex; flex-direction: column; gap: 6px; }",
+	".dshgui-mcp-card-title { font-weight: 600; display: flex; align-items: center; gap: 8px; justify-content: space-between; }",
+	".dshgui-mcp-card-desc { opacity: .7; line-height: 1.55; min-height: 34px; }",
+	".dshgui-mcp-btn { border: 1px solid color-mix(in srgb, currentColor 28%, transparent); background: transparent; color: inherit; border-radius: 8px; padding: 3px 10px; cursor: pointer; font-size: 12px; }",
+	".dshgui-mcp-btn:hover { border-color: color-mix(in srgb, currentColor 55%, transparent); }",
+	".dshgui-mcp-btn-primary { background: color-mix(in srgb, currentColor 12%, transparent); }",
+	".dshgui-mcp-btn-danger:hover { border-color: #e5534b; color: #e5534b; }",
+	".dshgui-mcp-row { display: flex; align-items: center; gap: 10px; border: 1px solid color-mix(in srgb, currentColor 14%, transparent); border-radius: 10px; padding: 8px 12px; margin-bottom: 8px; flex-wrap: wrap; }",
+	".dshgui-mcp-row-main { flex: 1 1 260px; min-width: 0; }",
+	".dshgui-mcp-row-name { font-weight: 600; display: flex; gap: 8px; align-items: center; }",
+	".dshgui-mcp-row-sub { opacity: .6; font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }",
+	".dshgui-mcp-badge { font-size: 11px; padding: 1px 7px; border-radius: 999px; border: 1px solid color-mix(in srgb, currentColor 30%, transparent); opacity: .85; }",
+	".dshgui-mcp-badge-on { background: rgba(46, 160, 67, .16); border-color: rgba(46, 160, 67, .45); }",
+	".dshgui-mcp-form { border: 1px solid color-mix(in srgb, currentColor 26%, transparent); border-radius: 12px; padding: 14px 16px; margin-top: 10px; display: grid; gap: 10px; grid-template-columns: 1fr 1fr; }",
+	".dshgui-mcp-field { display: flex; flex-direction: column; gap: 4px; }",
+	".dshgui-mcp-field-wide { grid-column: 1 / -1; }",
+	".dshgui-mcp-label { font-size: 12px; opacity: .75; }",
+	".dshgui-mcp-input, .dshgui-mcp-textarea { background: transparent; color: inherit; border: 1px solid color-mix(in srgb, currentColor 26%, transparent); border-radius: 8px; padding: 6px 9px; font: inherit; font-size: 13px; width: 100%; box-sizing: border-box; }",
+	".dshgui-mcp-textarea { resize: vertical; min-height: 56px; font-family: ui-monospace, Consolas, monospace; }",
+	".dshgui-mcp-error { color: #e5534b; font-size: 12px; }",
+	".dshgui-mcp-note { opacity: .65; font-size: 12px; line-height: 1.6; margin: 2px 0 0; }",
+	".dshgui-mcp-actions { display: flex; gap: 8px; justify-content: flex-end; grid-column: 1 / -1; }",
+	".dshgui-mcp-toggle { display: inline-flex; align-items: center; gap: 6px; cursor: pointer; user-select: none; }"
+].join("\n");
+
+let styleInjected = false;
+function ensureStyles() {
+	if (styleInjected || typeof document === "undefined") return;
+	const el = document.createElement("style");
+	el.id = "dshgui-mcp-style";
+	el.textContent = CSS;
+	document.head.appendChild(el);
+	styleInjected = true;
+}
+
+/* ------------------------------ components ------------------------------ */
+
+function Field(props) {
+	return h("label", { className: "dshgui-mcp-field" + (props.wide ? " dshgui-mcp-field-wide" : "") },
+		h("span", { className: "dshgui-mcp-label" }, props.label),
+		props.textarea
+			? h("textarea", { className: "dshgui-mcp-textarea", value: props.value, placeholder: props.placeholder || "", onChange: (e) => props.onChange(e.target.value) })
+			: h("input", { className: "dshgui-mcp-input", value: props.value, placeholder: props.placeholder || "", onChange: (e) => props.onChange(e.target.value) }),
+		props.hint ? h("span", { className: "dshgui-mcp-note" }, props.hint) : null,
+		props.error ? h("span", { className: "dshgui-mcp-error" }, props.error) : null
+	);
+}
+
+function CatalogCard(props) {
+	return h("div", { className: "dshgui-mcp-card" },
+		h("div", { className: "dshgui-mcp-card-title" }, h("span", null, props.item.title),
+			h("button", { className: "dshgui-mcp-btn dshgui-mcp-btn-primary", onClick: props.onAdd }, "添加")),
+		h("div", { className: "dshgui-mcp-card-desc" }, props.item.desc),
+		h("div", { className: "dshgui-mcp-row-sub" }, summarize({ transport: "stdio", command: props.item.command, args: props.item.args }).slice(0, 90))
+	);
+}
+
+function ServerRow(props) {
+	const s = props.server;
+	return h("div", { className: "dshgui-mcp-row" },
+		h("label", { className: "dshgui-mcp-toggle", title: s.enabled ? "点击停用" : "点击启用" },
+			h("input", { type: "checkbox", checked: s.enabled === true, onChange: () => props.onToggle(s.id) }),
+			h("span", null, s.enabled ? "已启用" : "已停用")),
+		h("div", { className: "dshgui-mcp-row-main" },
+			h("div", { className: "dshgui-mcp-row-name" },
+				h("span", null, s.serverName),
+				h("span", { className: "dshgui-mcp-badge" + (s.enabled ? " dshgui-mcp-badge-on" : "") }, s.transport)),
+			h("div", { className: "dshgui-mcp-row-sub", title: summarize(s) }, summarize(s))),
+		h("button", { className: "dshgui-mcp-btn", onClick: () => props.onEdit(s) }, "编辑"),
+		h("button", { className: "dshgui-mcp-btn dshgui-mcp-btn-danger", onClick: () => props.onDelete(s.id) }, "删除")
+	);
+}
+
+function ServerForm(props) {
+	const d = props.draft;
+	const set = (patch) => props.onDraft(Object.assign({}, d, patch));
+	return h("div", { className: "dshgui-mcp-form" },
+		h("div", { className: "dshgui-mcp-section-title", style: { gridColumn: "1 / -1", margin: "0" } }, props.isNew ? "添加：" + d.title : "编辑：" + d.serverName),
+		h(Field, { label: "服务名称 serverName（工具前缀 mcp__<名称>__…）", value: d.serverName || "", onChange: (v) => set({ serverName: v.trim() }), error: props.errors.name }),
+		h("label", { className: "dshgui-mcp-field" },
+			h("span", { className: "dshgui-mcp-label" }, "传输方式"),
+			h("select", { className: "dshgui-mcp-input", value: d.transport, onChange: (e) => set({ transport: e.target.value }) },
+				h("option", { value: "stdio" }, "stdio（本地命令）"),
+				h("option", { value: "streamable-http" }, "streamable-http（远程 HTTP）"))),
+		d.transport === "stdio"
+			? h(Field, { label: "启动命令", value: d.command || "", placeholder: "npx", onChange: (v) => set({ command: v }), error: props.errors.command })
+			: h(Field, { label: "服务器 URL", value: d.url || "", placeholder: "http://localhost:3000/mcp", onChange: (v) => set({ url: v }), error: props.errors.url }),
+		h(Field, { label: "环境变量（每行 KEY=VALUE；保存在本机 settings.yaml）", value: d.envText, textarea: true, placeholder: props.envPlaceholder || "KEY=value", onChange: (v) => set({ envText: v }) }),
+		d.transport === "stdio"
+			? h(Field, { label: "参数（每行一个）", value: d.argsText, textarea: true, placeholder: "-y\n@modelcontextprotocol/server-filesystem", onChange: (v) => set({ argsText: v }) })
+			: h(Field, { label: "请求头（每行 KEY=VALUE，可选）", value: d.headersText || "", textarea: true, placeholder: "Authorization=Bearer xxx", onChange: (v) => set({ headersText: v }) }),
+		h(Field, { label: "工具调用超时 ms（可选，默认 60000）", value: d.timeoutText || "", onChange: (v) => set({ timeoutText: v }) }),
+		props.errors.global ? h("div", { className: "dshgui-mcp-error", style: { gridColumn: "1 / -1" } }, props.errors.global) : null,
+		h("div", { className: "dshgui-mcp-actions" },
+			h("button", { className: "dshgui-mcp-btn", onClick: props.onCancel }, "取消"),
+			h("button", { className: "dshgui-mcp-btn dshgui-mcp-btn-primary", disabled: props.saving, onClick: props.onSave }, props.saving ? "保存中…" : "保存并启用"))
+	);
+}
+
+function MCPCatalogTab(props) {
+	const snap = props.useCatalog(function pickAll(s) { return s; });
+	const servers = (snap && snap.servers) || [];
+	const writable = !snap || snap.writable !== false;
+	const status = snap ? snap.status : "loading";
+	const [draft, setDraft] = React.useState(null);
+	const [errors, setErrors] = React.useState({});
+	const [saving, setSaving] = React.useState(false);
+
+	function openFromTemplate(item) {
+		setErrors({});
+		setDraft({
+			isNew: true, title: item.title, id: uid(), key: item.key,
+			serverName: item.key.replace(/[^A-Za-z0-9_-]/g, "-").slice(0, 32),
+			transport: "stdio", command: item.command || "npx",
+			argsText: formatArgsText(item.args), envText: item.envHint || "",
+			url: "", headersText: "", timeoutText: ""
+		});
+	}
+	function openEdit(server) {
+		setErrors({});
+		setDraft({
+			isNew: false, id: server.id, title: server.serverName,
+			serverName: server.serverName, transport: server.transport || "stdio",
+			command: server.command || "", argsText: formatArgsText(server.args),
+			envText: formatEnvText(server.env), url: server.url || "",
+			headersText: formatEnvText(server.headers), timeoutText: server.toolCallTimeoutMs != null ? String(server.toolCallTimeoutMs) : ""
+		});
+	}
+	function buildRecord(d) {
+		const record = { id: d.id, serverName: d.serverName, transport: d.transport, enabled: true };
+		if (d.transport === "stdio") {
+			record.command = d.command.trim();
+			record.args = parseArgsText(d.argsText);
+			const env = parseEnvText(d.envText);
+			if (Object.keys(env).length > 0) record.env = env;
+		} else {
+			record.url = d.url.trim();
+			const headers = parseEnvText(d.headersText);
+			if (Object.keys(headers).length > 0) record.headers = headers;
+		}
+		const timeout = Number(d.timeoutText);
+		if (d.timeoutText && Number.isFinite(timeout)) record.toolCallTimeoutMs = timeout;
+		return record;
+	}
+	async function save() {
+		const record = buildRecord(draft);
+		const errs = {};
+		const nameErrors = validateServer(record, servers);
+		for (const message of nameErrors) {
+			if (message.indexOf("重复") >= 0) errs.global = message;
+			else if (message.indexOf("stdio") >= 0 || message.indexOf("HTTP") >= 0) errs.command = message, errs.url = errs.url || message;
+			else errs.name = errs.name || message;
+		}
+		if (Object.keys(errs).length > 0) { setErrors(errs); return; }
+		setSaving(true);
+		try {
+			const next = draft.isNew ? servers.concat([record]) : servers.map((s) => (s.id === record.id ? Object.assign({}, s, record) : s));
+			await props.writeServers(next);
+			setDraft(null);
+		} catch (error) {
+			setErrors({ global: "保存失败：" + (error && error.message ? error.message : String(error)) });
+		} finally {
+			setSaving(false);
+		}
+	}
+	async function toggle(id) {
+		try { await props.writeServers(servers.map((s) => (s.id === id ? Object.assign({}, s, { enabled: !(s.enabled === true) }) : s))); } catch (e) { console.warn("[mcp-catalog] toggle failed", e); }
+	}
+	async function remove(id) {
+		try { await props.writeServers(servers.filter((s) => s.id !== id)); } catch (e) { console.warn("[mcp-catalog] delete failed", e); }
+	}
+
+	if (status === "unavailable") {
+		return h("div", { className: "dshgui-mcp-tab" },
+			h("p", { className: "dshgui-mcp-hint" }, "设置服务当前不可用（可能处于记忆模式或宿主半侧未挂载）。请确认已通过用户 patch 层插入 mcp-catalog 行并重启宿主。"));
+	}
+
+	const configuredKeys = new Set(servers.map((s) => s.serverName));
+
+	return h("div", { className: "dshgui-mcp-tab" },
+		h("h3", null, "MCP 服务器"),
+		h("p", { className: "dshgui-mcp-hint" },
+			"启用的服务器会即时挂载为模型工具（命名形如 mcp__服务名__工具名），改动无需重启。",
+			writable ? "" : "（当前文档只读，改动不会被保存。）"),
+		servers.length > 0 ? h("div", { className: "dshgui-mcp-section-title" }, "我的实例") : null,
+		servers.map((s) => h(ServerRow, { key: s.id, server: s, writable: writable, onToggle: toggle, onEdit: openEdit, onDelete: remove })),
+		servers.length === 0 ? h("p", { className: "dshgui-mcp-hint" }, "还没有实例。从下方目录一键添加，或选择「自定义服务器」。") : null,
+		h("div", { className: "dshgui-mcp-section-title" }, "目录"),
+		h("div", { className: "dshgui-mcp-grid" },
+			CATALOG.concat([blankCustom()]).map((item) => h(CatalogCard, { key: item.key, item: item, onAdd: () => openFromTemplate(item) }))),
+		draft ? h(ServerForm, {
+			draft: draft, errors: errors, saving: saving, isNew: !!draft.isNew,
+			envPlaceholder: draft.envHint || "",
+			onDraft: setDraft, onSave: save, onCancel: () => setDraft(null)
+		}) : null
+	);
+}
+
+/* ------------------------- plugin wiring ------------------------- */
+
+const inject = ["slots", "settingsScope"];
+
+function apply(ctx) {
+	ensureStyles();
+	const scope = ctx.settingsScope.bind({ namespace: NAMESPACE });
+	const store = createSnapshotStore({ status: "loading", writable: true, servers: [] });
+	const project = () => {
+		const snapshot = scope.getSnapshot();
+		return {
+			status: snapshot.status,
+			writable: snapshot.writable,
+			servers: snapshot.status === "ready" && snapshot.value && Array.isArray(snapshot.value.servers) ? snapshot.value.servers : []
+		};
+	};
+	const refresh = () => store.set(project());
+	ctx.effect(() => scope.subscribe(refresh), "mcp-catalog: settings mirror");
+	refresh();
+
+	async function writeServers(next) {
+		await scope.set("servers", next);
+	}
+
+	ctx.effect(() => ctx.slots.inject("settings.plugins.tab", () => ctx.slots.register({
+		name: "settings.plugins.tab",
+		id: "mcp-catalog",
+		order: 20,
+		label: "MCP",
+		inject: () => ({ catalog: store })
+	}, function MCPCatalogEntry(props) {
+		const useCatalog = props.useCatalog || function fallback() { return store.getSnapshot(); };
+		return h(MCPCatalogTab, { useCatalog: useCatalog, writeServers: writeServers });
+	})), "mcp-catalog: plugins tab");
+}
+
+exports.apply = apply;
+exports.inject = inject;
