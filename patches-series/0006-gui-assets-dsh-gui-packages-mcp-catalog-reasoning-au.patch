+/* @dsh-gui/mcp-catalog — browser half (authored source).
+ * Built by dev/tools/build-mcp-catalog.mjs into lib/client.js (lazy-CJS factory).
+ * Externals are require()'d at materialization time; they are declared in this
+ * package's dsh.client.external so the module graph provisions them.
+ */
+const React = require("react");
+const { createSnapshotStore } = require("@deepseek-ai/dsh-client-runtime/client");
+
+const h = React.createElement;
+const PKG_ID = "@dsh-gui/mcp-catalog";
+/** Must match the host half's settingsNamespace("mcp-catalog"). */
+const NAMESPACE = "mcp-catalog";
+const NAME_RE = /^[A-Za-z0-9_-]{1,32}$/;
+
+/* ------------------------------------------------------------------ */
+/* Curated catalog: one-click templates. args/env stay editable after */
+/* insertion; env entries are plain strings stored in the local user  */
+/* settings.yaml (single-machine desktop deployment).                 */
+/* ------------------------------------------------------------------ */
+const CATALOG = [
+	{ key: "memory", title: "Memory 记忆图谱", desc: "基于知识图谱的长期记忆（官方参考实现）。", command: "npx", args: ["-y", "@modelcontextprotocol/server-memory"], envHint: "" },
+	{ key: "seq-think", title: "Sequential Thinking 序贯思考", desc: "把复杂问题拆解为可修订的思考步骤。", command: "npx", args: ["-y", "@modelcontextprotocol/server-sequential-thinking"], envHint: "" },
+	{ key: "everything", title: "Everything 官方演示", desc: "官方全功能测试服务器，用于验证 MCP 链路是否畅通。", command: "npx", args: ["-y", "@modelcontextprotocol/server-everything"], envHint: "" },
+	{ key: "filesystem", title: "Filesystem 文件系统", desc: "让模型访问指定目录内的文件。添加后请在参数里填入允许的目录路径。", command: "npx", args: ["-y", "@modelcontextprotocol/server-filesystem", "C:/path/to/allowed/dir"], envHint: "" },
+	{ key: "github", title: "GitHub API", desc: "仓库 / Issue / PR 操作。需要 GITHUB_TOKEN。", command: "npx", args: ["-y", "@modelcontextprotocol/server-github"], envHint: "GITHUB_TOKEN=" },
+	{ key: "brave-search", title: "Brave 搜索", desc: "网页与新闻搜索。需要 BRAVE_API_KEY。", command: "npx", args: ["-y", "@modelcontextprotocol/server-brave-search"], envHint: "BRAVE_API_KEY=" },
+	{ key: "puppeteer", title: "Puppeteer 浏览器自动化", desc: "驱动无头浏览器完成网页交互与截图。", command: "npx", args: ["-y", "@modelcontextprotocol/server-puppeteer"], envHint: "" },
+	{ key: "sqlite", title: "SQLite 查询", desc: "对指定数据库文件执行只读 SQL 与商业洞察。添加后请在参数里填入数据库路径。", command: "npx", args: ["-y", "@modelcontextprotocol/server-sqlite", "--db-path", "C:/path/to/db.sqlite"], envHint: "" }
+];
+
+function blankCustom() {
+	return { key: "__custom", title: "自定义服务器", desc: "手动填写 stdio 命令或 HTTP 地址。", command: "npx", args: [], envHint: "" };
+}
+
+/* ---------------------------- tiny helpers ---------------------------- */
+
+function uid() {
+	return "mcp-" + Date.now().toString(36) + "-" + Math.random().toString(36).slice(2, 8);
+}
+
+function parseArgsText(text) {
+	return String(text || "").split(/\s+/).map((s) => s.trim()).filter((s) => s.length > 0);
+}
+
+function formatArgsText(args) {
+	return Array.isArray(args) ? args.join("\n") : "";
+}
+
+function parseEnvText(text) {
+	const env = {};
+	for (const rawLine of String(text || "").split(/\r?\n/)) {
+		const line = rawLine.trim();
+		if (!line || line.startsWith("#")) continue;
+		const eq = line.indexOf("=");
+		if (eq <= 0) continue;
+		const key = line.slice(0, eq).trim();
+		if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(key)) continue;
+		env[key] = line.slice(eq + 1);
+	}
+	return env;
+}
+
+function formatEnvText(env) {
+	return Object.entries(env || {}).map(([k, v]) => k + "=" + String(v)).join("\n");
+}
+
+function summarize(server) {
+	if (server.transport === "streamable-http") return String(server.url || "");
+	const parts = [server.command].concat(Array.isArray(server.args) ? server.args : []);
+	return parts.filter(Boolean).join(" ");
+}
+
+function validateServer(record, servers) {
+	const errors = [];
+	if (!NAME_RE.test(String(record.serverName || ""))) errors.push("服务名称须为 1-32 位字母/数字/_/-");
+	const others = servers.filter((s) => s.id !== record.id);
+	if (others.some((s) => s.serverName === record.serverName)) errors.push("服务名称与其他实例重复");
+	if (record.transport === "stdio") {
+		if (!String(record.command || "").trim()) errors.push("stdio 需要填写启动命令");
+	} else if (!String(record.url || "").trim()) {
+		errors.push("HTTP 需要填写服务器 URL");
+	}
+	return errors;
+}
+
