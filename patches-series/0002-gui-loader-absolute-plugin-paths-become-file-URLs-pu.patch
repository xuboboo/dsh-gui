-    const pickDialog = internals.pickWin32Dialog ?? pickWin32Directory
-    return await pickDialog(signal)
+    // dsh-gui: prefer the Electron launcher's native dialog; fall back to the
+    // koffi worker when the GUI endpoint is not being served (web-only or
+    // older desktop build).
+    try {
+      return await (internals.pickGuiDialog ?? pickGuiDialog)(signal)
+    } catch (error: unknown) {
+      if (signal.aborted) return null
+      if (errorCode(error) === GUI_PICKER_UNAVAILABLE
+        || (error instanceof Error && error.message === GUI_PICKER_UNAVAILABLE)) {
+        // The koffi-backed IFileOpenDialog child process — the modern picker
+        // with per-monitor-v2 DPI and abort support. koffi is a packaged
+        // dependency whose availability the install guarantees, so there is
+        // no fallback tier: any failure surfaces as-is (no PowerShell
+        // fallback tier).
+        const pickDialog = internals.pickWin32Dialog ?? pickWin32Directory
+        return await pickDialog(signal)
+      }
+      throw error
+    }
   }
 
