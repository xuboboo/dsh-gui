+  /**
+   * dsh-gui: import one bare specifier through the internal loader. The
+   * caller-relative base (profile-local node_modules and the flat fallback)
+   * keeps out-of-tree plugins and their peers working; when it misses (a
+   * fallback that is still materializing, or one a crashed boot left
+   * partial), in-box packages still resolve from this host's own
+   * node_modules — a packaged installation's asar tree.
+   */
+  private async importInternal(name: string, baseUrl: string) {
+    let lastError: unknown
+    for (const base of [baseUrl, new URL('../../../', import.meta.url).href]) {
+      if (base === undefined || base === null || base === '') continue
+      try {
+        return await this.ctx.loader.internal!.import(name, base, {})
+      } catch (error) {
+        lastError = error
+      }
+    }
+    throw lastError
+  }
+
   /** Persist current tree state. In-memory trees may implement this as a no-op. */
   abstract write(): void
 }
+
+/** dsh-gui: specifiers treated as local absolute paths (Windows drive, POSIX root, UNC). */
+const absolutePathPattern = /^[A-Za-z]:[\\/]|^[\\/]/
+
+/**
+ * dsh-gui: file:// URL for a local absolute path, without node:url so the
+ * browser bundle of this package stays free of node builtins (the same
+ * spelling node:path's pathToFileURL emits for drive paths, with every
+ * other segment percent-encoded).
+ */
+function absolutePathToFileHref(path: string): string {
+  const unified = path.replace(/\\/g, '/')
+  const parts = unified.split('/')
+  const isDrive = /^[A-Za-z]:$/.test(parts[0]!)
+  if (unified.startsWith('//')) return 'file://' + unified  // UNC share
+  const head = isDrive ? 'file:///' + parts[0] : 'file://' + (unified.startsWith('/') ? '' : '/')
+  const segments = isDrive ? parts.slice(1) : parts
+  const tail = segments.filter(segment => segment !== '').map(encodeURIComponent).join('/')
+  return head + '/' + tail
+}
