+// ---------------------------------------------------------------------------
+// dsh-gui: prefer the desktop launcher's Electron native dialog
+// (127.0.0.1:3082) over the koffi-backed worker. The desktop GUI registers
+// this endpoint in its main process; the dsh runtime is its child and can
+// reach it without CORS. When the endpoint is absent (web-only runtime,
+// launcher not serving, or an older desktop build) this throws a distinct
+// marker so the caller falls back to the koffi worker instead of failing.
+// ---------------------------------------------------------------------------
+const GUI_PICKER_URL = 'http://127.0.0.1:3082/pick-directory'
+const GUI_PICKER_UNAVAILABLE = 'gui-picker-unavailable'
+const GUI_PICKER_LONG_TIMEOUT_MS = 600_000
+
+async function pickGuiDialog(signal: AbortSignal, title = 'Select Workspace Directory'): Promise<string | null> {
+  const controller = new AbortController()
+  const onAbort = (): void => controller.abort()
+  signal.addEventListener('abort', onAbort, { once: true })
+  try {
+    // No artificial short timeout: 3082 is reachable iff the desktop launcher
+    // serves it, in which case the Electron dialog waits as long as the user
+    // needs. When the endpoint is absent, fetch rejects immediately
+    // (ECONNREFUSED) -> fall back to the koffi worker. A stale/gone launcher
+    // that never answers could hang, so keep a generous ceiling well beyond
+    // any normal dialog interaction.
+    const timeout = setTimeout(onAbort, GUI_PICKER_LONG_TIMEOUT_MS)
+    try {
+      const response = await fetch(GUI_PICKER_URL, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ title }),
+        signal: controller.signal,
+      })
+      if (!response.ok) throw new Error(GUI_PICKER_UNAVAILABLE)
+      const data = await response.json() as unknown
+      if (signal.aborted) return null
+      if (data !== null && typeof data === 'object' && 'cancelled' in data
+        && (data as { cancelled?: unknown }).cancelled === true) return null
+      const path = data !== null && typeof data === 'object' ? (data as { path?: unknown }).path : undefined
+      if (typeof path === 'string') return path
+      // Unknown shape: treat as unavailable so the caller falls back.
+      throw new Error(GUI_PICKER_UNAVAILABLE)
+    } finally {
+      clearTimeout(timeout)
+    }
+  } catch (error: unknown) {
+    if (signal.aborted) return null
+    // Endpoint unreachable / malformed / long-hung: signal fallback to koffi.
+    const err = new Error(GUI_PICKER_UNAVAILABLE)
+    ;(err as NodeJS.ErrnoException).code = GUI_PICKER_UNAVAILABLE
+    throw err
+  } finally {
+    signal.removeEventListener('abort', onAbort)
+  }
+}
