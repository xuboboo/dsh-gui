diff --git a/node_modules/@deepseek-ai/dsh-host-directory-picker-native/lib/worker.cjs b/node_modules/@deepseek-ai/dsh-host-directory-picker-native/lib/worker.cjs
new file mode 100644
index 0000000..4b93a41
--- /dev/null
+++ b/node_modules/@deepseek-ai/dsh-host-directory-picker-native/lib/worker.cjs
@@ -0,0 +1,110 @@
+/**
+ * Directory-picker worker (CJS).
+ *
+ * Primary: asks the launcher's loopback HTTP service (Electron native dialog,
+ * modal + focused, works in GUI and web client alike).
+ * Fallback: cscript Shell.Application.BrowseForFolder with Unicode-codepoint
+ * output and foreground re-activation, so older launchers still work.
+ * Protocol matches the official driver (showing/done/error over IPC).
+ */
+'use strict'
+
+const title = process.env.DSH_DIALOG_TITLE ?? ''
+if (title === '') throw new Error('win32-dialog-worker: DSH_DIALOG_TITLE is required')
+if (process.send === undefined) throw new Error('win32-dialog-worker must run as a child process with an IPC channel')
+const send = process.send.bind(process)
+
+const post = (message) => {
+  send(message, () => { if (process.connected) process.disconnect() })
+}
+process.on('disconnect', () => process.exit(0))
+
+send({ kind: 'showing', threadId: 0 })
+
+const { spawn } = require('node:child_process')
+const path = require('node:path')
+const fsNative = require('node:fs')
+const os = require('node:os')
+
+// ---- fallback: cscript BrowseForFolder with codepoint output ----
+const VBS_SCRIPT = [
+  'Set objShell = CreateObject("Shell.Application")',
+  'Set objFolder = objShell.BrowseForFolder(0, "Select Workspace Directory", &H41)',
+  'If Not objFolder Is Nothing Then',
+  '  Dim p: p = objFolder.Self.Path',
+  '  Dim i',
+  '  For i = 1 To Len(p)',
+  '    If i > 1 Then WScript.StdOut.Write(" ")',
+  '    WScript.StdOut.Write(AscW(Mid(p, i, 1)))',
+  '  Next',
+  'End If',
+].join('\r\n')
+
+function pickViaCscript() {
+  const vbsPath = path.join(os.tmpdir(), 'dsh-picker-' + process.pid + '.vbs')
+  fsNative.writeFileSync(vbsPath, '\ufeff' + VBS_SCRIPT, 'utf16le')
+  const child = spawn('cscript.exe', ['//nologo', vbsPath], {
+    windowsHide: true,
+    stdio: ['ignore', 'pipe', 'pipe'],
+  })
+  // Best-effort foreground activation so Alt+F4 closes the dialog itself.
+  for (const delay of [80, 200, 400, 700]) {
+    setTimeout(() => {
+      const act = spawn('powershell.exe', ['-NoProfile', '-Command', "$wshell = New-Object -ComObject WScript.Shell; $wshell.AppActivate('Select Workspace Directory')"], { windowsHide: true, stdio: 'ignore' })
+      act.unref()
+    }, delay)
+  }
+  let stdout = ''
+  let stderr = ''
+  child.stdout.on('data', (d) => { stdout += String(d) })
+  child.stderr.on('data', (d) => { stderr += String(d) })
+  child.on('error', (error) => {
+    try { fsNative.unlinkSync(vbsPath) } catch { }
+    post({ kind: 'error', message: String(error && error.message ? error.message : error) })
+  })
+  child.on('close', (code) => {
+    try { fsNative.unlinkSync(vbsPath) } catch { }
+    const line = stdout.trim().split(/\r?\n/)[0] || ''
+    let picked = null
+    if (line.length > 0) {
+      try {
+        const codes = line.split(' ').filter(Boolean).map((n) => Number.parseInt(n, 10))
+        if (codes.length > 0) picked = String.fromCharCode(...codes)
+      } catch { picked = line }
+    }
+    if (code === 0 && picked !== null && picked.length > 0) {
+      post({ kind: 'done', path: picked })
+    } else if (code === 0) {
+      post({ kind: 'done', path: null })
+    } else {
+      post({ kind: 'error', message: 'folder dialog failed (exit ' + code + '): ' + stderr.slice(0, 200) })
+    }
+  })
+}
+
+// ---- primary: launcher HTTP service (Electron native dialog) ----
+const port = Number(process.env.DSH_GUI_PICKER_PORT || 3082)
+const controller = new AbortController()
+const timer = setTimeout(() => controller.abort(), 1200)
+fetch('http://127.0.0.1:' + port + '/pick-directory', {
+  method: 'POST',
+  headers: { 'Content-Type': 'application/json' },
+  body: JSON.stringify({ title }),
+  signal: controller.signal,
+})
+  .then((response) => response.json())
+  .then((data) => {
+    clearTimeout(timer)
+    if (data !== null && typeof data === 'object' && data.cancelled === true) {
+      post({ kind: 'done', path: null })
+    } else if (data !== null && typeof data === 'object' && typeof data.path === 'string') {
+      post({ kind: 'done', path: data.path })
+    } else {
+      pickViaCscript()
+    }
+  })
+  .catch(() => {
+    clearTimeout(timer)
+    // Launcher service unavailable (older launcher): fall back to cscript.
+    pickViaCscript()
+  })
diff --git a/node_modules/@koromix/koffi-win32-x64/index.js b/node_modules/@koromix/koffi-win32-x64/index.js
new file mode 100644
index 0000000..6dba06c
--- /dev/null
+++ b/node_modules/@koromix/koffi-win32-x64/index.js
@@ -0,0 +1,12 @@
+let native = null;
+let err = null;
+if (native == null) {
+  try {
+    native = require("./win32_x64/koffi.node");
+  } catch (e) {
+    err = e;
+  }
+}
+if (native == null)
+  throw err;
+module.exports = native;
